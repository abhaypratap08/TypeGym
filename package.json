{
  "name": "typegym",
  "version": "1.0.0",
  "description": "A fast, elegant typing practice platform for developers",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "framer-motion": "^11.2.10",
    "lucide-react": "^1.72.0",
    "next": "15.5.28",
    "pusher": "^5.2.0",
    "pusher-js": "^8.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "10.4.27",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "jsdom": "^26.1.0",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true,
    "sharp@0.34.5": true
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5",
    "postcss": "$postcss",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.8"
    }
  }
}
